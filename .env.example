# Google Gemini API Key (obtained from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily API Key (obtained from tavily.com for web grounding - actually called by the codebase)
TAVILY_API_KEY=your_tavily_api_key_here
# Serper.dev API Key (alternative fallback search key)
SERPER_API_KEY=your_serper_api_key_here

# Database Configuration (Defaults to local SQLite file)
DATABASE_URL=sqlite:///./growth_os.db

# Chroma Vector DB Persistence Directory
CHROMA_PERSIST_DIR=./chroma_data

# Enterprise Security Configuration
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_fernet_encryption_key_here_or_leave_empty_for_dev
ALLOWED_ORIGINS=http://localhost:3000
